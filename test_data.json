    "rules": [
      {
        "id": "rule_hide_notes_if_inactive",
        "formConfigId": "complexFullTest",
        "fieldId": "accountActive",
        "enabled": true,
        "priority": 1,
        "conditions": [
          {
            "operator": "EQUALS",
            "value": false,
            "compareType": "value"
          }
        ],
        "action": {
          "type": "visibility",
          "value": false
        },
        "targets": [
          {
            "id": "bioNotes",
            "type": "field"
          }
        ]
      },
      {
        "id": "rule_warn_high_budget",
        "formConfigId": "complexFullTest",
        "fieldId": "annualBudget",
        "enabled": true,
        "priority": 2,
        "conditions": [
          {
            "operator": "GREATER_THAN",
            "value": 5000000,
            "compareType": "value"
          }
        ],
        "action": {
          "type": "info",
          "severity": "warning",
          "value": "Budget exceeds $5,000,000 threshold. Board approval required."
        },
        "targets": []
      }
    ]
  },
