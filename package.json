{
  "name": "dynamic-entity",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "node scripts/check-control-chars.mjs && turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "test:coverage": "turbo run test:coverage",
    "check:chars": "node scripts/check-control-chars.mjs"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.3.3",
    "rxjs": "^7.8.2",
    "turbo": "latest"
  },
  "overrides": {
    "rxjs": "^7.8.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.0",
    "@rollup/rollup-linux-x64-gnu": "^4.34.0"
  }
}
