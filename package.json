{
  "name": "dynamic-entity",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "node scripts/check-lockfile-platforms.mjs && node scripts/check-control-chars.mjs && node scripts/check-build-graph.mjs && node scripts/check-demo-coverage.mjs && node scripts/check-ssr.mjs && eslint \"packages/*/src/**/*.ts\" \"packages/*/src/**/*.html\" \"scripts/**/*.mjs\" \"packages/core/bin.mjs\" && turbo run lint",
    "test": "turbo run test",
    "benchmark": "node scripts/run-benchmarks.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:timezones": "node scripts/check-timezones.mjs",
    "dev": "turbo run dev",
    "test:coverage": "turbo run test:coverage",
    "check:chars": "node scripts/check-control-chars.mjs",
    "check:demo-coverage": "node scripts/check-demo-coverage.mjs",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" \"packages/*/src/**/*.html\" \"scripts/**/*.mjs\" --fix",
    "e2e": "npm run e2e --workspace=demo-angular",
    "check:build-graph": "node scripts/check-build-graph.mjs",
    "check:lockfile": "node scripts/check-lockfile-platforms.mjs"
  },
  "devDependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "rxjs": "^7.8.2",
    "turbo": "^2.10.12",
    "typescript-eslint": "^8.70.1",
    "zone.js": "~0.16.0"
  },
  "overrides": {
    "piscina": "5.3.2",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3"
  }
}
