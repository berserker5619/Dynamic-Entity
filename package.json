{
  "name": "dynamic-entity",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "node scripts/check-control-chars.mjs && eslint \"packages/*/src/**/*.ts\" \"scripts/**/*.mjs\" \"packages/core/cli.mjs\" && turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "test:coverage": "turbo run test:coverage",
    "check:chars": "node scripts/check-control-chars.mjs",
    "lint:fix": "eslint \"packages/*/src/**/*.ts\" \"scripts/**/*.mjs\" --fix",
    "e2e": "npm run e2e --workspace=demo-angular"
  },
  "devDependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "rxjs": "^7.8.2",
    "turbo": "latest",
    "zone.js": "~0.16.0"
  },
  "overrides": {
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3"
  }
}
