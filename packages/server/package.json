{
  "name": "@dynamic-entity/server",
  "version": "1.14.0",
  "description": "Streaming spreadsheet import for @dynamic-entity/core, with an Express adapter.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/express.ts --format cjs,esm --dts && node build-manifest.mjs",
    "test": "jest",
    "lint": "tsc --noEmit",
    "dev": "tsup src/index.ts src/express.ts --format cjs,esm --dts --watch",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@dynamic-entity/core": "^1.14.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@dynamic-entity/core": "^1.14.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "jszip": "^3.10.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dynamic-entity",
    "import",
    "spreadsheet",
    "xlsx",
    "csv",
    "streaming",
    "express"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/Dynamic-Entity.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/berserker5619/Dynamic-Entity/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/berserker5619/Dynamic-Entity/issues"
  },
  "author": "Nizamudeen",
  "dependencies": {
    "busboy": "1.6.0",
    "exceljs": "4.4.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
