{
  "name": "@dynamic-entity/core",
  "version": "1.1.0",
  "description": "Shared model + framework-agnostic form logic for the dynamic-entity ecosystem.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "jest",
    "lint": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "dynamic-entity",
    "typescript",
    "types"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/Dynamic-Entity.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/berserker5619/Dynamic-Entity/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/berserker5619/Dynamic-Entity/issues"
  },
  "author": "Nizamudeen"
}
