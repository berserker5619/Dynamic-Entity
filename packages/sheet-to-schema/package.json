{
  "name": "sheet-to-schema",
  "version": "1.0.0-rc.2",
  "description": "Turn spreadsheet rows into records that fit a schema you already have. The main entry is browser-safe with no runtime dependencies; sheet-to-schema/node reads files and serves HTTP.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "tsc --noEmit",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "busboy": "^1.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "busboy": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "busboy": "1.6.0",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "jest": "^30.0.0",
    "jszip": "^3.10.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "sideEffects": false
}
